generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  DOCTOR
  TECHNICIAN
  PHARMACIST
  PATIENT
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  ULTRASOUND
  ECHOCARDIOGRAM
  LAB_TEST
  FOLLOW_UP
}

enum DiagnosticCategory {
  LAB
  IMAGING
}

enum DiagnosticStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  REPORT_READY
  CANCELLED
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  COMPLETED
  CANCELLED
}

model Clinic {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  timezone    String    @default("UTC")
  currency    String    @default("USD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  doctors     Doctor[]
  appointments Appointment[]
  diagnostics DiagnosticTest[]
  pharmacyItems PharmacyItem[]
  prescriptions Prescription[]
}

model User {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email         String
  name          String
  role          UserRole
  phone         String?
  image         String?
  externalAuthId String?  @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  doctor        Doctor?
  patientAppointments Appointment[] @relation("PatientAppointments")
  prescriptions Prescription[] @relation("PatientPrescriptions")
  issuedPrescriptions Prescription[] @relation("IssuedPrescriptions")
  diagnosticTests DiagnosticTest[] @relation("PatientDiagnostics")
  assignedDiagnostics DiagnosticTest[] @relation("TechnicianDiagnostics")

  @@unique([clinicId, email])
  @@index([clinicId, role])
}

model Doctor {
  id            String    @id @default(cuid())
  clinicId      String
  userId        String    @unique
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty     String
  licenseNumber String?
  bio           String?
  consultationFee Decimal? @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  availability  DoctorAvailability[]
  appointments  Appointment[]
  prescriptions Prescription[] @relation("DoctorPrescriptions")

  @@index([clinicId, specialty])
}

model DoctorAvailability {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  slotMinutes Int    @default(30)
  active    Boolean  @default(true)

  @@unique([doctorId, weekday, startTime, endTime])
}

model Appointment {
  id             String            @id @default(cuid())
  clinicId       String
  doctorId       String?
  patientId      String
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor         Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  type           AppointmentType
  status         AppointmentStatus @default(REQUESTED)
  startsAt       DateTime
  endsAt         DateTime
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  diagnostic     DiagnosticTest?

  @@index([clinicId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
}

model DiagnosticTest {
  id             String            @id @default(cuid())
  clinicId       String
  appointmentId  String?           @unique
  patientId      String
  technicianId   String?
  clinic         Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment    Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient        User              @relation("PatientDiagnostics", fields: [patientId], references: [id], onDelete: Cascade)
  technician     User?             @relation("TechnicianDiagnostics", fields: [technicianId], references: [id], onDelete: SetNull)
  name           String
  category       DiagnosticCategory
  description    String?
  price          Decimal           @db.Decimal(10, 2)
  status         DiagnosticStatus  @default(ORDERED)
  reportUrl      String?
  orderedAt      DateTime          @default(now())
  completedAt    DateTime?

  @@index([clinicId, status])
  @@index([patientId, orderedAt])
}

model PharmacyItem {
  id             String   @id @default(cuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  genericName    String?
  category       String?
  unitPrice      Decimal  @db.Decimal(10, 2)
  stockQuantity  Int      @default(0)
  reorderLevel   Int      @default(10)
  expiryDate     DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  prescriptionItems PrescriptionItem[]

  @@unique([clinicId, sku])
  @@index([clinicId, stockQuantity])
}

model Prescription {
  id          String             @id @default(cuid())
  clinicId    String
  patientId   String
  doctorId    String
  issuedById  String?
  clinic      Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor             @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Restrict)
  issuedBy    User?              @relation("IssuedPrescriptions", fields: [issuedById], references: [id], onDelete: SetNull)
  status      PrescriptionStatus @default(ACTIVE)
  instructions String?
  issuedAt    DateTime           @default(now())
  dispensedAt DateTime?
  items       PrescriptionItem[]

  @@index([clinicId, status])
  @@index([patientId, issuedAt])
}

model PrescriptionItem {
  id            String       @id @default(cuid())
  prescriptionId String
  pharmacyItemId String?
  prescription  Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacyItem  PharmacyItem? @relation(fields: [pharmacyItemId], references: [id], onDelete: SetNull)
  medicineName  String
  dosage        String
  frequency     String
  duration      String
  quantity      Int?

  @@index([prescriptionId])
}
